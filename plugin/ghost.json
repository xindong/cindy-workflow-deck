{
  "schemaVersion": 3,
  "id": "jixin-make-a-wish",
  "name": "极心许愿",
  "description": "基础Git操作保留项目hooks与分支门禁；AI诊断分析问题与建议，高级工作流创建独立任务。",
  "whenToUse": "开始实验性工作、功能开发、工具开发、提交 PR 或整理分支时使用工作流快捷面板。",
  "version": "0.2.24",
  "minCindyVersion": "0.1.109",
  "entry": "main.js",
  "launch": "resident",
  "command": "jixin-make-a-wish",
  "tools": [
    {
      "name": "get_workflows",
      "description": "显示兼容聊天绑定卡。推荐直接在插件配置选择项目根目录，无需调用工具或绑定聊天即可从面板启动独立任务。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "report_progress",
      "description": "工作流任务将实际执行步骤、操作输出摘要和最终结果写回工作流面板。仅接受由本插件发起的任务，以宿主提供的当前会话核验归属。",
      "parameters": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "step",
              "output",
              "completed",
              "blocked"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "detail": {
            "type": "string",
            "maxLength": 3000
          }
        },
        "required": [
          "status",
          "title",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "assist_update_conflict",
      "description": "在当前已配置项目中真实创建AI冲突处理任务，或检查该任务结果。start仅在用户要求AI处理时调用；requestId保持稳定，回执不确定不要换ID重发。修复中的选择在新任务里回答；不会自动提交或上传。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "check"
            ]
          },
          "requestId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 60
          },
          "instructions": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "action",
          "requestId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "diagnose_issue",
      "description": "调用真实AI简短诊断当前配置项目的问题，只返回原因、下一步和验证，不执行修复，不显示发送快照。用户要求诊断时使用；相同请求保持requestId，不重放不确定调用。",
      "parameters": {
        "type": "object",
        "properties": {
          "problem": {
            "type": "string",
            "maxLength": 2000
          },
          "recentError": {
            "type": "string",
            "maxLength": 10000
          },
          "requestId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 60
          }
        },
        "required": [
          "problem",
          "requestId"
        ],
        "additionalProperties": false
      }
    }
  ],
  "cindy": {
    "text": [
      "oneshot"
    ]
  },
  "agent": {
    "tasks": true,
    "background": true,
    "errand": true
  },
  "locales": {
    "en": "locales/en.json",
    "zh-CN": "locales/zh-CN.json"
  },
  "icon": "assets/icon.png",
  "card": {},
  "panel": {
    "title": "极心许愿",
    "html": "panel.html",
    "position": "left",
    "minWidth": 280,
    "defaultFraction": 0.25
  },
  "sessionContext": true,
  "subscribe": {
    "topics": [
      "session",
      "turn",
      "activity"
    ]
  },
  "node": {
    "entry": "node/worker-entry.cjs",
    "protocol": "json-rpc-stdio",
    "lifecycle": "on-demand"
  },
  "settingsHtml": "settings.html",
  "pick": true,
  "preview": {
    "hosts": [
      "127.0.0.1"
    ]
  }
}
