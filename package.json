{
  "name": "jixin-make-a-wish",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "极心许愿：独立桌面与 Cindy 插件共用的项目配置、Git 与工作流工具。",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "dist": "python3 scripts/build_distribution.py",
    "dist:check": "python3 scripts/build_distribution.py --check && python3 scripts/install_local.py --dir release-assets --check",
    "prepare": "python3 scripts/install_hooks.py",
    "version:prepare": "python3 scripts/bump_version.py --staged",
    "test:release": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "desktop": "electron desktop/main.cjs",
    "desktop:package": "node scripts/package_desktop.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "playwright-core": "1.51.1"
  }
}
