{
  "name": "jixin-make-a-wish",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Agent 工作流快捷面板，运行于 Cindy 插件沙箱。",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "dist": "python3 scripts/build_distribution.py",
    "dist:check": "python3 scripts/build_distribution.py --check && python3 scripts/install_local.py --check",
    "prepare": "python3 scripts/install_hooks.py",
    "version:prepare": "python3 scripts/bump_version.py --staged",
    "test:release": "python3 -m unittest discover -s tests -p 'test_*.py' -v"
  },
  "engines": {
    "node": ">=22"
  }
}
